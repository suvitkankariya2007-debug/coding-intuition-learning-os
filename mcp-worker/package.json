{
  "name": "coding-intuition-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "verify:local": "node scripts/verify-local.mjs",
    "deploy": "wrangler deploy",
    "build:tunnel": "wrangler deploy --dry-run --config wrangler.tunnel.jsonc --outdir dist-tunnel",
    "memory:login": "node local/login.mjs",
    "tunnel:serve": "node local/server.mjs",
    "tunnel:doctor": "node local/doctor.mjs",
    "monitor:start": "node local/monitor.mjs start",
    "monitor:stop": "node local/monitor.mjs stop",
    "monitor:status": "node local/monitor.mjs status",
    "demo:adaptive": "node scripts/demo-adaptive.mjs",
    "verify:live": "node local/verify-live.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261018.1",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
